{
  "name": "okilo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start",
    "dev": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --clear",
    "tunnel": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --tunnel",
    "android": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --android",
    "ios": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p journeys",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm run format:check && npm run type-check && npm run test:coverage",
    "seed:personas": "jest --config scripts/personas/jest.config.js --runInBand --silent=false",
    "journeys": "jest --config journeys/jest.config.js --runInBand && node journeys/report.mjs && prettier --write journeys/REPORT.md"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro": "^55.1.1",
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "aes-js": "^3.1.2",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@expo/ngrok": "^4.1.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shell-quote": "^1.11.0",
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "uuid@<11.1.1": "^11.1.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
