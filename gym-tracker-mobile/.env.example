# Supabase (optional: without them the app runs offline, without accounts).
# Locally: copy this file to .env.local and fill it from the Supabase dashboard (Project Settings → API).
# EAS builds do not read .env.local: create the same variables once in the "production" environment:
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_URL --value "https://….supabase.co" --visibility plaintext
#   eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "…" --visibility sensitive
# Only the anon key goes here, never the service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
