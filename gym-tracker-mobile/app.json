{
  "expo": {
    "name": "GymTrack",
    "slug": "gym-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymtrack.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF6EC"
      },
      "package": "com.gymtrack.mobile",
      "permissions": ["android.permission.RECEIVE_BOOT_COMPLETED", "android.permission.VIBRATE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F7F5F0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6EC"
        }
      ],
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.gymtrack.mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "gymtrack",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
