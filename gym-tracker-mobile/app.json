{
  "expo": {
    "name": "Okilo",
    "slug": "gym-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.okilo",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Okilo n'utilise pas ta photothèque : cette autorisation ne te sera jamais demandée."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF6EC"
      },
      "package": "app.okilo",
      "permissions": ["android.permission.RECEIVE_BOOT_COMPLETED", "android.permission.VIBRATE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F7F5F0",
          "sounds": ["./assets/sounds/rest-bell.wav", "./assets/sounds/rest-alarm.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6EC"
        }
      ],
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.okilo"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Okilo écoute tes commandes pendant la séance (« fait », « 8 », « plus tard ») quand tu les actives.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Okilo écoute tes commandes pendant la séance (« fait », « 8 », « plus tard ») quand tu les actives.",
          "speechRecognitionPermission": "Okilo reconnaît tes commandes sur le téléphone, rien n'est envoyé."
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-asset",
      "expo-video",
      [
        "./modules/okilo-alarm/app.plugin.js",
        {
          "usage": "Okilo sonne la fin de ton repos comme un minuteur, même quand tu es sur une autre app."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "fr": "./i18n/native/fr.json",
      "en": "./i18n/native/en.json"
    },
    "scheme": "okilo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e3bf537c-bfba-4a3d-91c1-4868d5f89032"
      }
    },
    "owner": "2late",
    "updates": {
      "url": "https://u.expo.dev/e3bf537c-bfba-4a3d-91c1-4868d5f89032"
    }
  }
}
