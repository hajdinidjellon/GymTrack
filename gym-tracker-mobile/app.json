{
  "expo": {
    "name": "GymTrack",
    "slug": "gym-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymtrack.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF6EC"
      },
      "package": "com.gymtrack.mobile",
      "permissions": ["android.permission.RECEIVE_BOOT_COMPLETED", "android.permission.VIBRATE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F7F5F0",
          "sounds": ["./assets/sounds/rest-bell.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6EC"
        }
      ],
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.hajdinidjellon.gymtrack"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "GymTrack écoute tes commandes pendant la séance (« fait », « 8 », « plus tard ») quand tu les actives.",
          "speechRecognitionPermission": "GymTrack reconnaît tes commandes sur le téléphone, rien n'est envoyé."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "gymtrack",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e3bf537c-bfba-4a3d-91c1-4868d5f89032"
      }
    },
    "owner": "2late",
    "updates": {
      "url": "https://u.expo.dev/e3bf537c-bfba-4a3d-91c1-4868d5f89032"
    }
  }
}
