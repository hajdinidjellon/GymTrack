{
  "expo": {
    "name": "GymTrack",
    "slug": "gym-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymtrack.mobile",
      "infoPlist": {
        "NSHealthShareUsageDescription": "GymTrack lit votre poids depuis Apple Santé pour suivre votre progression.",
        "NSHealthUpdateUsageDescription": "GymTrack peut enregistrer vos séances dans Apple Santé."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E3B2E"
      },
      "package": "com.gymtrack.mobile",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F1EAD8"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E3B2E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "gymtrack"
  }
}
